<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetSwitch.App.ViewModels"
        x:Class="NetSwitch.App.Views.ApplyConfirmationWindow"
        x:DataType="vm:ApplyConfirmationViewModel"
        Title="应用预设"
        Width="660"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
  <Border Background="#FFFFFF"
          BorderBrush="{DynamicResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 12 40 0 #26000000">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,18,14,0" PointerPressed="Header_OnPointerPressed">
        <StackPanel Spacing="3">
          <TextBlock Text="应用预设" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AdapterLine}" Classes="caption" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon" Click="Cancel_OnClick" VerticalAlignment="Top">
          <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="22,16,22,0" Spacing="10">
        <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12,10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconNetwork}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" />
            <TextBlock Text="{Binding PresetName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChangeRowViewModel">
                <Border BorderBrush="#F0F1F3" BorderThickness="0,0,0,1" Padding="12,8">
                  <Grid ColumnDefinitions="80,*,26,*">
                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Before}" FontSize="11.5" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Path Grid.Column="2" Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding After}" FontSize="11.5" FontWeight="Medium" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Border Background="{DynamicResource AmberSoftBrush}"
                BorderBrush="{DynamicResource AmberBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                IsVisible="{Binding IsDangerous}">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IconWarning}" Fill="{DynamicResource AmberBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,0,0" />
            <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="2">
              <TextBlock Text="这是一次危险变更" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}" />
              <TextBlock Text="{Binding DangerReasons}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding WarningText}" FontSize="11.5" LineHeight="18" Classes="muted" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                IsVisible="{Binding IsSimulated}">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,0,0" />
            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11.5" LineHeight="18" Classes="muted">
              M1 使用模拟后端演示完整流程；应用到真实网卡、自动回滚与快照将在 M2 接入 Windows 后端后启用。
            </TextBlock>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="22,20,22,18">
        <Button Classes="secondary" Content="取消" Click="Cancel_OnClick" />
        <Button Classes="primary" Content="应用配置" Click="Confirm_OnClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
