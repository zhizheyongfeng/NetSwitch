<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetSwitch.App.ViewModels"
        x:Class="NetSwitch.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="880"
        Height="740"
        MinWidth="780"
        MinHeight="620"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
  <Border Background="#FFFFFF"
          BorderBrush="{DynamicResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 12 40 0 #26000000">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,18,14,10" PointerPressed="Header_OnPointerPressed">
        <StackPanel Spacing="3">
          <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="NetSwitch · 本地配置，无需联网" Classes="caption" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" VerticalAlignment="Top">
          <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform" />
        </Button>
      </Grid>

      <TabControl Grid.Row="1" Margin="18,0,18,0" TabStripPlacement="Left">
        <!-- 常规 -->
        <TabItem Header="常规">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,4,14,16" Spacing="10">
              <TextBlock Text="常规" Classes="h2" />
              <TextBlock Text="控制窗口行为与适配器显示。" Classes="muted" FontSize="11.5" />

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <CheckBox Content="关闭主窗口时最小化到托盘" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                  <CheckBox Content="启动后最小化到托盘" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                  <CheckBox Content="开机自启（登录时以管理员权限启动，无 UAC 弹窗）"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                            IsVisible="{Binding StartupSupported}" />
                  <CheckBox Content="显示虚拟网卡（Hyper-V、VMware、TAP 等）" IsChecked="{Binding ShowVirtualAdapters, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="160,*" Margin="0,4,0,0">
                    <TextBlock Text="主题" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="160">
                      <ComboBoxItem Content="浅色" />
                      <ComboBoxItem Content="跟随系统" />
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="160,*">
                    <TextBlock Text="语言" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="简体中文（当前版本仅提供中文）" FontSize="11.5" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                      BorderThickness="1" CornerRadius="9" Padding="12,10">
                <TextBlock Text="托盘菜单支持直接切换预设。关闭到托盘后，应用仍会在后台监听 Wi-Fi 与配置状态。"
                           FontSize="11" LineHeight="17" Classes="muted" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 安全与回滚 -->
        <TabItem Header="安全与回滚">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,4,14,16" Spacing="10">
              <TextBlock Text="安全与回滚" Classes="h2" />
              <TextBlock Text="危险变更指修改主 IPv4 地址、默认网关、禁用 IPv6，或在唯一联网适配器上断开 Wi-Fi。"
                         Classes="muted" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="12">
                  <CheckBox Content="应用预设前显示确认对话框" IsChecked="{Binding ConfirmBeforeApply, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="160,*">
                    <TextBlock Text="自动恢复" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding AutoRevertModeIndex, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="220">
                      <ComboBoxItem Content="关闭" />
                      <ComboBoxItem Content="仅危险变更（推荐）" />
                      <ComboBoxItem Content="始终" />
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="160,*">
                    <TextBlock Text="倒计时秒数" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding AutoRevertSeconds, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
                  </Grid>
                  <TextBlock Text="倒计时结束会自动恢复到应用前的快照；点击“保持应用”才会保留新配置。范围 10–600 秒。"
                             Classes="caption" FontSize="10.5" Margin="160,0,0,0" LineHeight="16" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBorderBrush}"
                      BorderThickness="1" CornerRadius="9" Padding="12,10">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Data="{StaticResource IconWarning}" Fill="{DynamicResource AmberBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,0,0" />
                  <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" LineHeight="17" Classes="muted" TextWrapping="Wrap">
                    通过远程桌面或 SSH 修改唯一联网适配器时，建议保持自动恢复开启，并优先在本地控制台操作。
                  </TextBlock>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 存储 -->
        <TabItem Header="存储">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,4,14,16" Spacing="10">
              <TextBlock Text="存储" Classes="h2" />
              <TextBlock Text="所有会保存到磁盘的文件都可以自定义位置。修改后会先校验目录，并可选择迁移现有数据。"
                         Classes="muted" FontSize="11.5" LineHeight="18" />

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="9">
                  <TextBlock Text="存储模式" FontSize="12.5" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton GroupName="storagemode" Content="统一数据目录" IsChecked="{Binding !IsCustomMode, Mode=OneWay}" Command="{Binding SetUnifiedModeCommand}" />
                    <RadioButton GroupName="storagemode" Content="分项自定义" IsChecked="{Binding IsCustomMode, Mode=OneWay}" Command="{Binding SetCustomModeCommand}" />
                  </StackPanel>

                  <Grid ColumnDefinitions="82,*,Auto" Margin="0,4,0,0">
                    <TextBlock Text="数据目录" FontSize="11.5" Classes="muted" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DataRoot, Mode=TwoWay}" Watermark="例如 D:\NetSwitchData" />
                    <Button Grid.Column="2" Classes="secondary" Content="浏览…" Margin="6,0,0,0" Command="{Binding BrowseDataRootCommand}" />
                  </Grid>
                  <TextBlock Text="统一模式下所有文件都放在此目录；分项自定义时，未单独指定的项目以此目录为基准。"
                             Classes="caption" FontSize="10.5" Margin="82,0,0,0" />
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="14" IsVisible="{Binding IsCustomMode}">
                <StackPanel Spacing="8">
                  <TextBlock Text="分项路径" FontSize="12.5" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="82,*,Auto">
                    <TextBlock Text="配置文件" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ConfigFile, Mode=TwoWay}" Watermark="C:\...\config.json" />
                    <Button Grid.Column="2" Classes="secondary" Content="浏览…" Margin="6,0,0,0" Command="{Binding BrowseConfigFileCommand}" />
                  </Grid>
                  <Grid ColumnDefinitions="82,*,Auto">
                    <TextBlock Text="快照目录" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SnapshotDirectory, Mode=TwoWay}" />
                    <Button Grid.Column="2" Classes="secondary" Content="浏览…" Margin="6,0,0,0" Command="{Binding BrowseDirectoryCommand}" CommandParameter="snapshot" />
                  </Grid>
                  <Grid ColumnDefinitions="82,*,Auto">
                    <TextBlock Text="日志目录" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding LogDirectory, Mode=TwoWay}" />
                    <Button Grid.Column="2" Classes="secondary" Content="浏览…" Margin="6,0,0,0" Command="{Binding BrowseDirectoryCommand}" CommandParameter="log" />
                  </Grid>
                  <Grid ColumnDefinitions="82,*,Auto">
                    <TextBlock Text="导出目录" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ExportDirectory, Mode=TwoWay}" />
                    <Button Grid.Column="2" Classes="secondary" Content="浏览…" Margin="6,0,0,0" Command="{Binding BrowseDirectoryCommand}" CommandParameter="export" />
                  </Grid>
                  <Grid ColumnDefinitions="82,*,Auto">
                    <TextBlock Text="备份目录" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding BackupDirectory, Mode=TwoWay}" />
                    <Button Grid.Column="2" Classes="secondary" Content="浏览…" Margin="6,0,0,0" Command="{Binding BrowseDirectoryCommand}" CommandParameter="backup" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="7">
                  <TextBlock Text="实际路径" FontSize="12.5" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding PreviewRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PathPreviewRow">
                        <Grid ColumnDefinitions="76,*" Margin="0,2">
                          <TextBlock Text="{Binding Label}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
                          <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Path}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill" Padding="6,0" Margin="8,0,0,0">
                              <TextBlock Text="{Binding Source}" Classes="pill-text" FontSize="10" />
                            </Border>
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding BootstrapFile, StringFormat='引导文件（固定位置）：{0}'}"
                             Classes="caption" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <CheckBox Content="保存时把现有配置和目录迁移到新位置" IsChecked="{Binding MigrateExisting, Mode=TwoWay}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 测试 -->
        <TabItem Header="测试">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,4,14,16" Spacing="10">
              <TextBlock Text="测试" Classes="h2" />
              <TextBlock Text="第一阶段是静态检查，不修改网络；可选的连通性测试会临时应用配置，结束后强制恢复。"
                         Classes="muted" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <CheckBox Content="测试网关连通性（Ping 默认网关）" IsChecked="{Binding TestPingGateway, Mode=TwoWay}" />
                  <CheckBox Content="直接测试 DNS 服务器" IsChecked="{Binding TestDnsServersDirectly, Mode=TwoWay}" />
                  <CheckBox Content="测试公网 TCP 连接" IsChecked="{Binding TestPublicTcp, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="180,*">
                    <TextBlock Text="测试域名" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding TestDnsDomain, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="180,*">
                    <TextBlock Text="TCP 端口" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding TestTcpPort, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="180,*">
                    <TextBlock Text="单项超时（秒）" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding TestTimeoutSeconds, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
                  </Grid>
                  <Grid ColumnDefinitions="180,*">
                    <TextBlock Text="试运行最长时长（秒）" FontSize="11.5" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding TestTrialMaxSeconds, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 数据 -->
        <TabItem Header="数据">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,4,14,16" Spacing="10">
              <TextBlock Text="数据" Classes="h2" />
              <TextBlock Text="日志与预设的导入导出。应用不会启动资源管理器或外部编辑器，所有内容在应用内查看。"
                         Classes="muted" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="日志" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ResolvedLogDirectory}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="查看日志" Command="{Binding ViewLogsCommand}" />
                    <Button Classes="secondary" Content="导出今日日志…" Command="{Binding ExportLogCommand}" />
                    <Button Classes="secondary" Content="复制日志目录" Command="{Binding CopyLogPathCommand}" />
                    <Button Classes="secondary" Content="清理日志…" Command="{Binding CleanLogsCommand}" />
                  </StackPanel>
                  <TextBlock Text="日志记录网络变更与测试过程；在日志窗口中可复制选中/全部内容，也可删除单个或全部日志。"
                             Classes="caption" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="预设导入 / 导出" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ResolvedExportDirectory, StringFormat='默认导出目录：{0}'}"
                             Classes="caption" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="导出配置…" Command="{Binding ExportConfigCommand}" />
                    <Button Classes="secondary" Content="导入配置…" Command="{Binding ImportConfigCommand}" />
                  </StackPanel>
                  <TextBlock Text="导入按适配器 GUID 合并；同名预设会重命名，不会覆盖现有预设。设置项不会被导入覆盖。"
                             Classes="caption" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="历史快照" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ResolvedSnapshotDirectory}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                  <Button Classes="secondary" Content="清理历史快照…" HorizontalAlignment="Left" Command="{Binding CleanHistoryCommand}" />
                  <TextBlock Text="只删除 history 目录；last.json 与未完成事务的 pending.json 会保留，以免失去恢复能力。"
                             Classes="caption" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="配置备份" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ConfigBackupFile}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                  <Button Classes="secondary" Content="清理配置备份…" HorizontalAlignment="Left" Command="{Binding CleanBackupsCommand}" />
                  <TextBlock Text="配置文件损坏时应用会自动读取该 .bak 备份。删除后若配置损坏将无法自动回退。"
                             Classes="caption" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding DataStatusText}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 关于 -->
        <TabItem Header="关于">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,4,14,16" Spacing="10">
              <TextBlock Text="关于" Classes="h2" />
              <Border Classes="card" Padding="14">
                <StackPanel Spacing="8">
                  <TextBlock Text="NetSwitch 网络配置切换器" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="为多网卡、软路由改造和紧急网络切换设计。所有网络写入都通过 Windows 系统 API 完成，不调用命令行工具。"
                             Classes="muted" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="120,*" Margin="0,4,0,0">
                    <TextBlock Text="版本" Classes="caption" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding AppVersionText}" Classes="mono" FontSize="11" />
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Text="平台" Classes="caption" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding PlatformText}" FontSize="11" />
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Text="运行权限" Classes="caption" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding ElevationText}" FontSize="11" />
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Text=".NET 运行时" Classes="caption" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding DotNetText}" Classes="mono" FontSize="11" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBorderBrush}"
                      BorderThickness="1" CornerRadius="9" Padding="12,10">
                <TextBlock Text="修改网络参数可能导致暂时断网。首次使用建议在副网卡上试验，并保留自动恢复倒计时。"
                           FontSize="11" LineHeight="17" Classes="muted" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="22,13">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Data="{StaticResource IconWarning}" Fill="{DynamicResource RedBrush}" Width="13" Height="13" Stretch="Uniform" IsVisible="{Binding HasError}" />
            <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource GreenBrush}" Width="13" Height="13" Stretch="Uniform" IsVisible="{Binding !HasError}" />
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="恢复默认路径" Command="{Binding RestoreDefaultCommand}" />
            <Button Classes="secondary" Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="primary" Content="保存" Command="{Binding SaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
