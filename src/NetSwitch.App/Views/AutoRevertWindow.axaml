<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetSwitch.App.Views.AutoRevertWindow"
        Title="自动恢复"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="True"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        Background="Transparent">
  <Border Background="#FFFFFF"
          BorderBrush="{DynamicResource AmberBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 12 40 0 #26000000">
    <StackPanel Margin="22,20,22,18" Spacing="14">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AmberSoftBrush}" VerticalAlignment="Top">
          <Path Data="{StaticResource IconWarning}" Fill="{DynamicResource AmberBrush}" Width="18" Height="18" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
          <TextBlock x:Name="PresetText" Text="已应用配置" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="网络参数已写入。如果这次修改导致断网，可以立即恢复。"
                     FontSize="11.5" LineHeight="18" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel Spacing="4">
          <TextBlock x:Name="CountdownText"
                     Text="60"
                     FontSize="30"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource AmberBrush}" />
          <TextBlock x:Name="CountdownCaption"
                     Text="秒内保持，否则自动恢复到应用前配置"
                     FontSize="11.5"
                     Classes="muted"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="GatewayStatusText"
                     Text=""
                     FontSize="10.5"
                     Classes="caption"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="secondary" Content="保持应用" Click="Keep_OnClick" />
        <Button Classes="danger" Content="立即恢复" Click="Revert_OnClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
