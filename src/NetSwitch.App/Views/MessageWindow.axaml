<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetSwitch.App.Views.MessageWindow"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
  <Border Background="White"
          BorderBrush="{DynamicResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 12 40 0 #26000000">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,18,12,0">
        <TextBlock x:Name="TitleText" Text="提示" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Click="Cancel_OnClick">
          <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform" />
        </Button>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="44,*" Margin="22,16,22,0">
        <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
          <Path x:Name="IconPath" Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" />
        </Border>
        <TextBlock x:Name="MessageText"
                   Grid.Column="1"
                   Margin="12,1,0,0"
                   Text="消息"
                   FontSize="13"
                   LineHeight="21"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="22,22,22,20">
        <Button x:Name="CancelButton" Classes="secondary" Content="取消" Click="Cancel_OnClick" IsVisible="False" />
        <Button x:Name="ConfirmButton" Classes="primary" Content="知道了" Click="Confirm_OnClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
