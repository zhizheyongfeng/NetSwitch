<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetSwitch.App.Views.LogViewerWindow"
        Title="日志"
        Width="900"
        Height="620"
        MinWidth="700"
        MinHeight="420"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
  <Border Background="#FFFFFF"
          BorderBrush="{DynamicResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 12 40 0 #26000000">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,16,14,10" PointerPressed="Header_OnPointerPressed">
        <StackPanel Spacing="3">
          <TextBlock Text="运行日志" FontSize="17" FontWeight="SemiBold" />
          <TextBlock x:Name="DirectoryText" Text="" Classes="caption" FontSize="10.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon" Click="Close_OnClick" VerticalAlignment="Top">
          <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform" />
        </Button>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="190,*" Margin="18,0,18,0">
        <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,10">
          <ListBox x:Name="FileList" SelectionChanged="FileList_OnSelectionChanged" Background="Transparent" />
        </Border>
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Margin="0,0,0,10">
          <TextBox x:Name="LogText"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,monospace"
                   FontSize="11"
                   Background="#FAFAFB"
                   VerticalContentAlignment="Top"
                   BorderThickness="0" />
        </Border>
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="22,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" Text="" FontSize="11" Classes="muted" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <CheckBox x:Name="AutoRefreshBox" Content="自动刷新" IsChecked="True" FontSize="11"
                      VerticalAlignment="Center" />
            <Button Classes="secondary" Content="刷新" Click="Refresh_OnClick" />
            <Button Classes="secondary" Content="复制选中" Click="CopySelected_OnClick" />
            <Button Classes="secondary" Content="复制全部" Click="Copy_OnClick" />
            <Button Classes="secondary" Content="删除当前" Click="DeleteCurrent_OnClick" />
            <Button Classes="secondary" Content="删除全部日志" Click="DeleteAll_OnClick" />
            <Button Classes="primary" Content="关闭" Click="Close_OnClick" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
